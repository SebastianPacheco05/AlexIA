# GemiLexa: ejemplo publico, sin secretos reales.
# Solo BIND_ADDR se utiliza en esta version.
# El binario NO carga .env automaticamente: exporta variables en tu shell.
BIND_ADDR=127.0.0.1:3000

# Reservadas para una fase posterior; hoy no se leen ni habilitan integraciones.
# Configurar junto al usuario. No existe un interruptor para omitir verificacion.
# ALEXA_SKILL_ID=REPLACE_WITH_YOUR_SKILL_ID
# GEMINI_API_KEY=REPLACE_WITH_YOUR_API_KEY
# GEMINI_MODEL=REPLACE_WITH_AN_ELIGIBLE_FREE_TIER_MODEL
# No se requiere ni se configura Supabase.
