# AlexIA: ejemplo publico, sin secretos reales.
# La interfaz guarda aqui los ajustes; .env tiene prioridad sobre el shell.
BIND_ADDR=127.0.0.1:3000

# Skill personal de desarrollo. No existe un interruptor para omitir verificacion.
ALEXA_SKILL_ID=
# No se necesita API key con el inicio de sesion personal de Antigravity.
# GEMINI_API_KEY=REPLACE_WITH_YOUR_API_KEY
# Antigravity CLI: nombre base del modelo y nivel de razonamiento para Alexa.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LEVEL=low
AI_PROVIDER=antigravity

# UI PORT
UI_HOST=localhost
UI_PORT=3001
UI_MODE=dev
